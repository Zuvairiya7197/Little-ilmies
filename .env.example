# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/little_ilmies?schema=public"

# Auth.js / NextAuth
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Email via Resend (magic-link sign-in and order emails). Leave the key
# empty in local dev to print links and emails in the terminal instead.
RESEND_API_KEY=""
EMAIL_FROM="Little Ilmies <contact@littleilmies.com>"

# Razorpay (all payments, including PayPal and Apple Pay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Site
SITE_URL="http://localhost:3000"

# Local private storage (full PDFs, previews, covers live outside /public)
PRIVATE_UPLOADS_DIR="./private-uploads"

# Backblaze B2 (production file storage — falls back to PRIVATE_UPLOADS_DIR
# above when any of these are unset, e.g. in local dev). All four are
# required together for B2 to be used at all. Get these from the B2
# dashboard: create a private bucket, then an Application Key scoped to
# just that bucket (Read and Write access).
B2_KEY_ID=""
B2_APP_KEY=""
B2_BUCKET_NAME=""
# Bucket endpoint, e.g. "https://s3.us-west-004.backblazeb2.com"
B2_ENDPOINT=""
# Region portion of the endpoint above, e.g. "us-west-004". Defaults to
# us-west-004 if unset — only needed if your bucket is in a different region.
B2_REGION=""

# Optional: a public CDN domain (e.g. Cloudflare in front of a B2 custom
# domain) serving cover images and free-preview pages only — never full
# PDFs or Rent & Read pages, which always stay behind an authenticated
# route regardless of this setting. Leave unset to keep serving those
# assets through the app's own proxy routes.
ASSETS_CDN_DOMAIN=""

# Shared secret for signed links to paid PDFs and Rent & Read pages on the
# Cloudflare assets Worker (cloudflare/assets-worker.js). Set the same value
# on the Worker. Leave unset to serve those files straight from B2.
ASSETS_SIGNING_SECRET=""
