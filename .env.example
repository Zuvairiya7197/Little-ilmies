# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/little_ilmies?schema=public"

# Auth.js / NextAuth
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Email (used for OTP / magic link buyer login and transactional emails)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="Little Ilmies <hello@littleilmies.com>"

# Razorpay (primary payment gateway)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional payment gateways
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""

# Site
SITE_URL="http://localhost:3000"

# Local private storage (full PDFs, previews, covers live outside /public)
PRIVATE_UPLOADS_DIR="./private-uploads"

# Vercel Blob (production file storage — falls back to PRIVATE_UPLOADS_DIR
# above when unset, e.g. in local dev). BLOB_READ_WRITE_TOKEN is required
# for Blob to be used at all; it's provided automatically when a Blob
# store is connected to the Vercel project, so it usually doesn't need to
# be set manually. BLOB_WEBHOOK_PUBLIC_KEY is NOT required by this app —
# admin file uploads are attached to a product via our own API call after
# upload, not via a Blob webhook — leave it unset unless that changes.
BLOB_READ_WRITE_TOKEN=""
